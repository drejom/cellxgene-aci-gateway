# ── Gateway ──────────────────────────────────────────────────────────────────
GATEWAY_PORT=5005
GATEWAY_EXPIRE_SECONDS=3600          # idle timeout before ACI teardown
CELLXGENE_BACKEND=aci
EXTERNAL_PROTOCOL=https
PROXY_FIX_FOR=1
PROXY_FIX_PROTO=1
PROXY_FIX_HOST=1
GATEWAY_LOG_DIR=/logs                # optional; JSON logs written here

# ── Azure identity (Managed Identity preferred; omit for MI) ─────────────────
# AZURE_CLIENT_ID=                   # uncomment for user-assigned MI
# AZURE_TENANT_ID=                   # required for SP auth
# AZURE_CLIENT_SECRET=               # required for SP auth

# ── Azure subscription / resource group ──────────────────────────────────────
AZURE_SUBSCRIPTION_ID=<your-subscription-id>
AZURE_RESOURCE_GROUP=RG-YOUR-RG

# ── ACI provisioning ─────────────────────────────────────────────────────────
AZURE_SUBNET_ID=/subscriptions/<sub>/resourceGroups/<rg>/providers/Microsoft.Network/virtualNetworks/<vnet>/subnets/aci
ACI_CELLXGENE_IMAGE=<registry>/cellxgene:1.3.0
ACI_MEMORY_GB=8
ACI_CPU=2

# Per-dataset resource overrides (JSON, key = substring of filename)
# ACI_DATASET_RESOURCES={"pankbase":{"memory":56,"cpu":8}}

# ── Private registry (if ACI_CELLXGENE_IMAGE is private) ─────────────────────
ACI_REGISTRY_SERVER=<registry-login-server>
ACI_REGISTRY_USER=<username>
ACI_REGISTRY_PASSWORD=<password-or-token>

# ── Azure Files (dataset storage) ────────────────────────────────────────────
ACI_FILES_ACCOUNT=<storage-account-name>
ACI_FILES_SHARE=cellxgene-data
ACI_FILES_KEY=<storage-account-key>
